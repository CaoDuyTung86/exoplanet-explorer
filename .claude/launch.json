{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8010", "--reload"],
      "cwd": "server",
      "port": 8010
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3001
    },
    {
      "name": "web-api-8010",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set API_PROXY_TARGET=http://127.0.0.1:8010 && pnpm dev -- --port 3002 --strictPort"
      ],
      "port": 3002
    }
  ]
}
