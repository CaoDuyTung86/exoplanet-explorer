# Matches the docker-compose service (host port 5433).
DATABASE_URL=postgresql://exo:exo_dev_password@localhost:5433/exoplanets
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Presence fan-out between API processes. Optional: with no Redis reachable the hub
# falls back to an in-memory registry (single process only) and logs that it did.
REDIS_URL=redis://localhost:6380/0

# Set to true when the API is served over HTTPS, so the session cookie is https-only.
COOKIE_SECURE=false

# Where share links live, as the outside world sees them. Leave empty and the preview
# page believes the request instead — right when /s/ is proxied onto the origin that
# serves the app, which is what the Vite dev server and the nginx snippet in README do.
# Set it when the app lives somewhere else, or behind a proxy that drops X-Forwarded-*.
PUBLIC_BASE_URL=
